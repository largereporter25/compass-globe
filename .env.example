# Neon Postgres connection string (required for saving investigations).
# Get one free at https://neon.tech — copy the pooled connection string.
# The app runs without it, but nothing will be persisted.
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Optional. Mapillary client access token (free, MIT-licensed community street imagery).
# https://www.mapillary.com/dashboard/developers -> "Access tokens"
# Without it, street-level ground-truth cross-check is skipped and the UI says so.
MAPILLARY_TOKEN=""

# Contact string sent as the User-Agent to OpenStreetMap Nominatim.
# Nominatim's usage policy REQUIRES a real identifying contact. Set this before deploying.
NOMINATIM_USER_AGENT="compass-globe/0.1 (your-email@example.com)"
